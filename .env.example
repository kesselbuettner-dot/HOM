# HOM-Anmeldung – bcrypt-Hash des gemeinsamen Benutzers hom.
# Dieser Wert bleibt nur auf dem NAS in einer lokalen .env-Datei.
# Keinen Klartext und keinen echten Hash im öffentlichen GitHub-Repository hinterlegen.
HOM_PASSWORD_HASH=

# Paperless-ngx (optional, erst nach Berechtigungstest aktivieren).
# Einen eigenen Nicht-Admin-Dienstnutzer "hom-archiv" mit Leserechten NUR auf
# einzeln freigegebene Hauskosten-Dokumente in Paperless anlegen.
# URL muss aus dem HOM-App-Container erreichbar sein; HTTP nur im internen LAN.
HOM_PAPERLESS_URL=
# Persönliches API-Token des Dienstnutzers "hom-archiv", NIE Admin-Token.
HOM_PAPERLESS_TOKEN=
# Numerische ID des besonderen Tags "HOM-Freigabe" (Pflicht).
HOM_PAPERLESS_RELEASE_TAG_ID=
# Numerische IDs erlaubter Hauskosten-Tags, durch Komma getrennt.
# z.B. Strom, Gas, Wasser, Abwasser, Versicherungen, Grundsteuer.
HOM_PAPERLESS_CATEGORY_TAG_IDS=
